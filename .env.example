# Crie sua chave gratuita em https://openrouter.ai/keys e copie este arquivo para .env
OPENROUTER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3-ultra-550b-a55b:free

TEMPERATURE_TRIAGEM=0.1
TEMPERATURE_HELPER=0.3
MAX_TOKENS=2000
REASONING_EFFORT=low

REQUEST_TIMEOUT_S=45
MAX_RETRIES=2
USE_JSON_MODE=true
